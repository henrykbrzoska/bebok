{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bebok",
  "version": "1.7.0",
  "identifier": "dev.bebok.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/bebok/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Bebok",
        "label": "main",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/bebok-server"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/henrykbrzoska/bebok/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMDhEN0YwODhEMEQzOTMKUldTVDA5Q0k4TmNJc3l2TFU4ZjN0VmdJR3lEZFc1QmJBU0hiNkVHS2lBNnFmcWZsQ3EyUjkveEwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
