{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bebok",
  "version": "0.1.0",
  "identifier": "dev.bebok.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/bebok/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Bebok",
        "label": "main",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/bebok-server"]
  }
}
