{
  "identifier": "default",
  "description": "Bebok desktop: invoke our engine commands (engine_info, open_browser_viewer) + native dialogs for the picker; the browser viewer windows (browser-viewer-<session>) get the same set",
  "windows": ["main", "browser-viewer-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "dialog:default",
    "shell:default",
    "fs:allow-read-file",
    "fs:allow-read",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "bebok-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
